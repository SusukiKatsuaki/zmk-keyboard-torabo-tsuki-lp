#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>


/ {
    behaviors {
        jis_minus: jis_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp EQUAL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        lt150: lt_150 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };
        lt250: lt_250 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };
    };
    macros {
        cornix_macro0: cornix_macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(LC(N))) &kp LC(LA(LEFT))>;
        };
        cornix_macro1: cornix_macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(LC(N))) &kp LC(LA(RIGHT))>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        layer_0 {
            bindings = <
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &kp ESC  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC
                &kp TAB  &kp A  &kp S  &kp D  &kp F  &kp G  &none  &none  &lt150 4 H  &kp J  &kp K  &kp L  &jis_minus  &kp RET
                &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &mo 5  &to 4  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                &kp LCTRL  &kp LGUI  &kp LALT  &mo 5  &lt250 3 LANG2  &kp LGUI  &lt150 1 SPACE  &lt150 1 SPACE  &lt150 2 LANG1  &none  &none  &kp RALT  &kp RGUI  &kp LC(LG(SPACE))
            >;
        };
        layer_1 {
            bindings = <
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &trans  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &kp LS(N7)  &kp LS(BSLH)  &kp EQUAL  &kp LS(EQUAL)  &kp LS(N8)  &kp DEL
                &trans  &none  &none  &kp LSHFT  &kp TAB  &kp BSPC  &none  &none  &kp COMMA  &kp SEMI  &kp LS(SQT)  &kp LS(GRAVE)  &kp LS(MINUS)  &kp LS(N1)
                &trans  &none  &none  &none  &none  &kp RET  &none  &none  &kp DOT  &kp LS(SEMI)  &kp SQT  &kp GRAVE  &kp BSLH  &kp LA(FSLH)
                &trans  &trans  &trans  &trans  &kp LCTRL  &kp LCMD  &kp LALT  &kp RALT  &kp RCMD  &none  &none  &kp LS(N6)  &kp LA(Y)  &kp GRAVE
            >;
        };
        layer_2 {
            bindings = <
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &trans  &kp F9  &kp F10  &kp F11  &kp F12  &kp C_FAST_FORWARD  &cornix_macro0  &kp PG_UP  &kp UP  &kp PG_DN  &cornix_macro1  &kp DEL
                &trans  &kp F5  &kp F6  &kp F7  &kp F8  &kp BSPC  &none  &none  &kp HOME  &kp LEFT  &kp DOWN  &kp RIGHT  &kp END  &kp RSHFT
                &trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp RET  &none  &none  &kp LC(LA(LG(LEFT)))  &kp LC(LA(LEFT))  &kp LC(LA(BSPC))  &kp LC(LA(RIGHT))  &kp LC(LA(LG(RIGHT)))  &none
                &trans  &trans  &trans  &trans  &kp BSPC  &kp RET  &kp DEL  &none  &none  &none  &none  &none  &kp LS(LG(N5))  &kp LS(LG(N4))
            >;
        };
        layer_3 {
            bindings = <
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &trans  &none  &none  &kp N7  &kp N8  &kp N9  &kp KP_EQUAL  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MULTIPLY  &kp BSPC
                &trans  &kp SPACE  &none  &kp N4  &kp N5  &kp N6  &none  &none  &kp KP_PLUS  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_SUBTRACT  &kp RET
                &trans  &none  &none  &kp N1  &kp N2  &kp N3  &none  &none  &kp KP_COMMA  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DIVIDE  &kp LA(Y)
                &trans  &trans  &trans  &trans  &kp N0  &kp LGUI  &kp N0  &kp LS(SEMI)  &kp KP_N0  &none  &none  &kp KP_COMMA  &kp KP_PLUS  &kp KP_NUMLOCK
            >;
        };
        layer_4 {
            bindings = <
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &mkp LCLK  &mkp RCLK  &none  &none  &none
                &none  &none  &none  &none  &none  &none  &to 0  &to 0  &none  &none  &none  &kp RSHFT  &none  &none
                &none  &none  &none  &to 0  &none  &none  &none  &kp RET  &mkp LCLK  &none  &none  &none  &none  &none
            >;
        };
        layer_5 {
            bindings = <
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &studio_unlock  &bt BT_NXT  &bt BT_PRV  &none  &out OUT_USB  &out OUT_BLE  &none  &none  &mkp MCLK  &none  &none  &none
                &none  &kp C_VOL_DN  &kp C_VOL_UP  &mkp LCLK  &mkp RCLK  &mkp MCLK  &none  &none  &none  &mkp LCLK  &mkp RCLK  &mo 6  &none  &none
                &none  &msc SCRL_UP  &msc SCRL_DOWN  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &none  &none  &none  &trans  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
        layer_6 {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

